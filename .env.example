# Telegram bot (bun + grammY)
# The bot is a thin interactive shell around the Mini App storefront (TZ §1.2):
# /start, deep links and navigation to the deployed frontend — which is the Mini App.

# ---- Core ----
TELEGRAM_BOT_TOKEN=

# Mini App URL — the deployed frontend (HTTPS required by Telegram).
# Falls back to PUBLIC_BASE_URL when unset.
WEBAPP_URL=

# Backend origin — only used to read the public config (support link, TZ §3.7).
# Unset → the bot works without the API at all.
API_BASE_URL=

# Optional direct override for the support link (otherwise admin → Settings → support_link).
SUPPORT_URL=

# ---- Production: webhook mode (long polling is used when WEBHOOK_URL is unset) ----
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000
